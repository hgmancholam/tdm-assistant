# PersonalAssistant — Environment Variables
# Copy this file, rename to .env, and fill in your values.
# Load in PowerShell profile: Add-Content $PROFILE "`$env:VAR = 'value'"

# ── TDM Assistant ──────────────────────────────────────────────────────────────
# Nombre que el asistente usa para identificarse (aparece en briefings y respuestas)
ASSISTANT_NAME=Friday

# Apodo con el que el asistente se dirige al usuario
USER_NICKNAME=Harol

# ── Anthropic API (para runner_api.py — automatizaciones avanzadas) ───────────
# Requerido solo si usas runner_api.py en lugar de runner.ps1
# Genera en: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Microsoft Graph API (opcional) ────────────────────────────────────────────
# Solo necesario si usas herramientas basadas en Graph API.
# No requerido para la integración COM de Outlook (email/calendario/contactos).
GRAPH_CLIENT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
GRAPH_TENANT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# ── ADO — configuración por proyecto ──────────────────────────────────────────
# La configuración de Azure DevOps (org, project, PAT) es por proyecto.
# Cada proyecto la define en su archivo: projects/<CODE>/project.settings → sección "ado"
#
# Campos en project.settings:
#   ado.org      → nombre de la organización ADO (ej: "mi-empresa")
#   ado.project  → nombre del proyecto ADO (ej: "CRM-2026")
#   ado.pat      → Personal Access Token para ese org/proyecto
#
# Para generar un PAT: https://dev.azure.com/<org>/_usersSettings/tokens
# Scopes recomendados: Work Items (Read & Write), Code (Read), Build (Read)
